#!/bin/bash

# 1. كتابة كود main.dart بالواجهة المطلوبة تماماً ودون تغيير
cat << 'DART_EOF' > lib/main.dart
import 'dart:io';
import 'dart:convert';
import 'package:flutter/material.dart';
