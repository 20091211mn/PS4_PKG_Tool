<file path=".github/workflows/build-ps4-app.yml">
name: Build PS4 Homebrew App

on:
  workflow_dispatch:
  push:
    branches:
      - main
    paths:
      - 'scripts/**'
      - 'assets/**'
      - 'app/**'
      - '.github/workflows/build-ps4-app.yml'

jobs:
  build-ps4:
    name: Build PS4 PKG
    runs-on: ubuntu-20.04
    steps:
      - uses: actions/checkout@v4

      - name: Get OpenOrbis Toolchain
        run: bash scripts/get_toolchain.sh

      - name: Debug toolchain
        run: bash scripts/debug.sh

      - name: Install Build Dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y imagemagick clang lld make

      - name: Build and create PKG
        run: bash scripts/build.sh

      - name: Upload PKG Artifact
        uses: actions/upload-artifact@v4
        with:
          name: PS4-App-PKG
          path: out/*.pkg
          if-no-files-found: warn
</file>

<file path=".github/workflows/build-dev.yml">
name: Build Developer Admin APK

on:
  push:
    branches:
      - main
      - master

jobs:
  build-dev:
    name: Build Developer Admin APK
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: "17"

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: "stable"

      - name: Clean & Get Dependencies
        run: |
          flutter clean
          flutter pub get

      - name: Setup signing
        env:
          KS_B64: ${{ secrets.KEYSTORE_BASE64 }}
          KS_PASS: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASS: ${{ secrets.KEY_PASSWORD }}
        run: |
          if [ -n "$KS_B64" ]; then
            echo "$KS_B64" | base64 -d > android/app/release.keystore
            printf 'storePassword=%s\nkeyPassword=%s\nkeyAlias=%s\nstoreFile=release.keystore\n' "$KS_PASS" "$KEY_PASS" "$KEY_ALIAS" > android/key.properties
            ls -l android/app/release.keystore
          else
            echo "NO SIGNING SECRETS - using debug key"
          fi

      - name: Generate icons
        run: dart run flutter_launcher_icons

      - name: Build Dev Admin Release APK
        run: |
          set -o pipefail
          flutter build apk --release --flavor dev --target lib/main_admin.dart --no-tree-shake-icons --android-skip-build-dependency-validation 2>&1 | tee build.log || { echo '=== REAL ERROR ==='; grep -n -B3 -A15 'What went wrong\|Failed to apply\|error:' build.log | head -80; exit 1; }

      - name: Upload Dev Admin APK
        uses: actions/upload-artifact@v4
        with:
          name: Developer-Admin-APK
          path: build/app/outputs/flutter-apk/app-dev-release.apk
</file>

