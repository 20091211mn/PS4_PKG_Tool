            label: 'دمج',
          ),
          BottomNavigationBarItem(
            icon: Icon(Icons.send),
            label: 'نقل لـ PS4',
          ),
          BottomNavigationBarItem(
            icon: Icon(Icons.storefront),
            label: 'المتجر',
          ),
        ],
      ),
    );
  }
}

