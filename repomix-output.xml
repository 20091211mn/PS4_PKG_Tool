<file path="PS4_PKG_Tool/.github/workflows/build_ios.yml">
name: Build iOS Application

on:
  workflow_dispatch:

jobs:
  build-ios:
    runs-on: macos-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: "stable"
          architecture: x64

      - name: Generate iOS Project
        run: flutter create --platforms=ios .

      - name: Patch Info.plist
        run: |
          P=ios/Runner/Info.plist
          /usr/libexec/PlistBuddy -c "Add :NSAppTransportSecurity dict" $P
          /usr/libexec/PlistBuddy -c "Add :NSAppTransportSecurity:NSAllowsArbitraryLoads bool true" $P
          /usr/libexec/PlistBuddy -c "Add :NSLocalNetworkUsageDescription string 'Needed to send PKG files to PS4'" $P
          /usr/libexec/PlistBuddy -c "Add :UIFileSharingEnabled bool true" $P || /usr/libexec/PlistBuddy -c "Set :UIFileSharingEnabled true" $P
          /usr/libexec/PlistBuddy -c "Add :LSSupportsOpeningDocumentsInPlace bool true" $P || /usr/libexec/PlistBuddy -c "Set :LSSupportsOpeningDocumentsInPlace true" $P
          /usr/libexec/PlistBuddy -c "Add :UISupportsDocumentBrowser bool true" $P || /usr/libexec/PlistBuddy -c "Set :UISupportsDocumentBrowser true" $P

          cat $P

      - name: iOS target and bundle id
        run: |
          cd ios
          if [ -f Podfile ]; then sed -i '' -E "s/^# *platform :ios, .*/platform :ios, '15.0'/; s/^platform :ios, .*/platform :ios, '15.0'/" Podfile; fi
          sed -i '' -E 's/IPHONEOS_DEPLOYMENT_TARGET = [0-9.]+;/IPHONEOS_DEPLOYMENT_TARGET = 15.0;/g' Runner.xcodeproj/project.pbxproj
          sed -i '' 's/com\.example\.ps4PkgTool/com.ps4pkg.studio/g' Runner.xcodeproj/project.pbxproj
          grep -n "IPHONEOS_DEPLOYMENT_TARGET\|PRODUCT_BUNDLE_IDENTIFIER" Runner.xcodeproj/project.pbxproj | head -6

      - name: Install Dependencies
        run: flutter pub get

      - name: Generate icons
        run: dart run flutter_launcher_icons -f flutter_launcher_icons_ios.yaml

      - name: Build iOS Application (No Codesign)
        run: flutter build ios --release --no-codesign

      - name: Package Payload folder for TIPA/IPA
        run: |
          cd build/ios/iphoneos
          mkdir Payload
          mv Runner.app Payload/
          zip -r PS4_PKG_Tool_iOS.ipa Payload

      - name: Upload iOS Build Artifact
        uses: actions/upload-artifact@v4
        with:
          name: PS4_PKG_Tool_iOS_Build
          path: build/ios/iphoneos/PS4_PKG_Tool_iOS.ipa
</file>

<file path="PS4_PKG_Tool/.github/workflows/build-dev.yml">
name: Build Developer Admin APK

on:
  push:
    branches:
      - main
      - master

jobs:
  build-dev:
    name: Build Developer Admin APK
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: "17"

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: "stable"

      - name: Clean & Get Dependencies
        run: |
          flutter clean
          flutter pub get

      - name: Setup signing
        env:
          KS_B64: ${{ secrets.KEYSTORE_BASE64 }}
          KS_PASS: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASS: ${{ secrets.KEY_PASSWORD }}
        run: |
          if [ -n "$KS_B64" ]; then
            echo "$KS_B64" | base64 -d > android/app/release.keystore
            printf 'storePassword=%s\nkeyPassword=%s\nkeyAlias=%s\nstoreFile=release.keystore\n' "$KS_PASS" "$KEY_PASS" "$KEY_ALIAS" > android/key.properties
            ls -l android/app/release.keystore
          else
            echo "NO SIGNING SECRETS - using debug key"
          fi

      - name: Generate icons
        run: dart run flutter_launcher_icons

      - name: Build Dev Admin Release APK
        run: |
          set -o pipefail
          flutter build apk --release --flavor dev --target lib/main_admin.dart --no-tree-shake-icons --android-skip-build-dependency-validation 2>&1 | tee build.log || { echo '=== REAL ERROR ==='; grep -n -B3 -A15 'What went wrong\|Failed to apply\|error:' build.log | head -80; exit 1; }

      - name: Upload Dev Admin APK
        uses: actions/upload-artifact@v4
        with:
          name: Developer-Admin-APK
